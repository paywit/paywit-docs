{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Paywit",
  "description": "Paywit developer documentation.",
  "colors": {
    "primary": "#6e63f6",
    "light": "#8177ff",
    "dark": "#5b50e0"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "introduction",
          "quickstart"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/hosted-checkout",
          "guides/webhooks",
          "guides/payment-statuses",
          "guides/test-on-sandbox"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-reference/introduction",
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      },
      {
        "group": "SDKs",
        "pages": [
          "sdks/javascript",
          "sdks/flutter"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.sandbox.paywit.xyz"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/paywit_xyz",
      "linkedin": "https://www.linkedin.com/company/paywit-xyz/",
      "instagram": "https://www.instagram.com/paywit.xyz"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Instrument Sans"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  }
}